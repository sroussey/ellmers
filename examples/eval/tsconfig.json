{
  // No `references`: with `use-source` stubs, project-reference redirect turns
  // `dist/*.d.ts` → `src` and makes stub `export * from "../src/browser"` a
  // self-import, so every `@workglow/*` export appears missing.
  "extends": "../../tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "composite": true,
    "outDir": "dist",
    "rootDir": "./src",
    // Nothing here is JSX. `@workglow/cli` is, and under `use-source` its
    // stubbed `dist/*.d.ts` re-export `../src`, so typechecking this package
    // reaches that package's `.tsx` and needs the same setting it uses.
    "jsx": "react-jsx"
  }
}
