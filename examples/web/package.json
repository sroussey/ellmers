{
  "name": "@workglow/web",
  "version": "0.4.1",
  "bugs": {
    "url": "https://github.com/workglow-dev/libs/issues"
  },
  "type": "module",
  "description": "Web interface example for Workglow, showcasing a React-based UI for building and visualizing AI task pipelines.",
  "homepage": "https://workglow.dev",
  "scripts": {
    "dev": "concurrently --kill-others -c 'auto' -n app,types 'bunx --bun vite --port 3800' 'tsc -w --noEmit --preserveWatchOutput'",
    "build-example": "concurrently -c 'auto' -n 'code,types' 'bun run build-code' 'bun run build-types'",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-code": "vite build",
    "analyze": "ANALYZE=1 vite build",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsgo",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --port 3800",
    "test": "vitest run --config ../../vitest.config.ts --project web"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@codemirror/language": "6.12.4",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.10",
    "@workglow/ai": "workspace:*",
    "@workglow/knowledge-base": "workspace:*",
    "@workglow/huggingface-transformers": "workspace:*",
    "@workglow/indexeddb": "workspace:*",
    "@workglow/tf-mediapipe": "workspace:*",
    "@workglow/storage": "workspace:*",
    "@workglow/job-queue": "workspace:*",
    "@workglow/task-graph": "workspace:*",
    "@workglow/tasks": "workspace:*",
    "@workglow/util": "workspace:*",
    "@mediapipe/tasks-text": "catalog:",
    "@mediapipe/tasks-vision": "catalog:",
    "@mediapipe/tasks-audio": "catalog:",
    "@mediapipe/tasks-genai": "catalog:",
    "@radix-ui/react-icons": "^1.3.2",
    "@huggingface/transformers": "catalog:",
    "@uiw/codemirror-theme-vscode": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "react": "catalog:",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.12.3",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "vite": "^8.2.2",
    "vite-plugin-wasm": "^3.6.0"
  },
  "publishConfig": {
    "access": "none"
  },
  "exports": {}
}
