{
  // No `references`: with `use-source` stubs, project-reference redirect turns
  // `dist/*.d.ts` → `src` and makes stub `export * from "../src/browser"` a
  // self-import, so every `@workglow/*` export appears missing.
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "composite": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "customConditions": ["browser"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */

    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": ["dist"]
}
