{
  "extends": "../../tsconfig.json",
  "include": ["src/worker.ts", "src/common.ts", "src/provider-utils.ts", "src/*/**/*"],
  "files": [
    "./src/worker.ts",
    "./src/browser.ts",
    "./src/node.ts",
    "./src/provider-utils.ts",
    "./src/test-entry.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "src/**/*.test-d.ts",
    "src/**/__tests__/**",
    "src/**/*.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "references": [
    {
      "path": "../util"
    },
    {
      "path": "../storage"
    },
    {
      "path": "../job-queue"
    },
    {
      "path": "../task-graph"
    },
    {
      "path": "../knowledge-base"
    }
  ]
}
