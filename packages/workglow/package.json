{
  "name": "workglow",
  "type": "module",
  "version": "0.2.31",
  "repository": {
    "type": "git",
    "url": "https://github.com/workglow-dev/workglow.git",
    "directory": "packages/workglow"
  },
  "description": "Workglow meta-package: re-exports all @workglow/* packages for convenient single-import usage.",
  "scripts": {
    "watch": "concurrently -c 'auto' 'bun:watch-*'",
    "watch-js": "bun run build.ts",
    "watch-types": "tsc --watch --preserveWatchOutput",
    "build-package": "concurrently -c 'auto' -n 'js,types' 'bun run build-js' 'bun run build-types'",
    "build-js": "bun run build.ts",
    "build-clean": "rm -fr dist/* tsconfig.tsbuildinfo",
    "build-types": "rm -f tsconfig.tsbuildinfo && tsgo",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "bun test"
  },
  "exports": {
    ".": {
      "react-native": {
        "types": "./src/browser.ts",
        "import": "./src/browser.ts"
      },
      "browser": {
        "types": "./src/browser.ts",
        "import": "./src/browser.ts"
      },
      "bun": {
        "types": "./src/bun.ts",
        "import": "./src/bun.ts"
      },
      "types": "./src/node.ts",
      "import": "./src/node.ts"
    },
    "./anthropic": {
      "browser": {
        "types": "./src/anthropic.ts",
        "import": "./src/anthropic.browser.ts"
      },
      "bun": {
        "types": "./src/anthropic.ts",
        "import": "./src/anthropic.bun.ts"
      },
      "types": "./src/anthropic.ts",
      "import": "./src/anthropic.ts"
    },
    "./anthropic/runtime": {
      "types": "./src/anthropic-runtime.ts",
      "import": "./src/anthropic-runtime.ts"
    },
    "./gemini": {
      "browser": {
        "types": "./src/google-gemini.ts",
        "import": "./src/google-gemini.browser.ts"
      },
      "bun": {
        "types": "./src/google-gemini.ts",
        "import": "./src/google-gemini.bun.ts"
      },
      "types": "./src/google-gemini.ts",
      "import": "./src/google-gemini.ts"
    },
    "./gemini/runtime": {
      "types": "./src/google-gemini-runtime.ts",
      "import": "./src/google-gemini-runtime.ts"
    },
    "./hf-transformers": {
      "browser": {
        "types": "./src/hf-transformers.ts",
        "import": "./src/hf-transformers.browser.ts"
      },
      "bun": {
        "types": "./src/hf-transformers.ts",
        "import": "./src/hf-transformers.bun.ts"
      },
      "types": "./src/hf-transformers.ts",
      "import": "./src/hf-transformers.ts"
    },
    "./hf-transformers/runtime": {
      "types": "./src/hf-transformers-runtime.ts",
      "import": "./src/hf-transformers-runtime.ts"
    },
    "./ollama": {
      "browser": {
        "types": "./src/ollama.ts",
        "import": "./src/ollama.browser.ts"
      },
      "bun": {
        "types": "./src/ollama.ts",
        "import": "./src/ollama.bun.ts"
      },
      "types": "./src/ollama.ts",
      "import": "./src/ollama.ts"
    },
    "./ollama/runtime": {
      "types": "./src/ollama-runtime.ts",
      "import": "./src/ollama-runtime.ts"
    },
    "./openai": {
      "browser": {
        "types": "./src/openai.ts",
        "import": "./src/openai.browser.ts"
      },
      "bun": {
        "types": "./src/openai.ts",
        "import": "./src/openai.bun.ts"
      },
      "types": "./src/openai.ts",
      "import": "./src/openai.ts"
    },
    "./openai/runtime": {
      "types": "./src/openai-runtime.ts",
      "import": "./src/openai-runtime.ts"
    },
    "./tf-mediapipe": {
      "types": "./src/tf-mediapipe.ts",
      "import": "./src/tf-mediapipe.ts"
    },
    "./tf-mediapipe/runtime": {
      "types": "./src/tf-mediapipe-runtime.ts",
      "import": "./src/tf-mediapipe-runtime.ts"
    },
    "./chrome-ai": {
      "types": "./src/chrome-ai.ts",
      "import": "./src/chrome-ai.ts"
    },
    "./chrome-ai/runtime": {
      "types": "./src/chrome-ai-runtime.ts",
      "import": "./src/chrome-ai-runtime.ts"
    },
    "./worker": {
      "react-native": {
        "types": "./src/worker-browser.ts",
        "import": "./src/worker-browser.ts"
      },
      "browser": {
        "types": "./src/worker-browser.ts",
        "import": "./src/worker-browser.ts"
      },
      "bun": {
        "types": "./src/worker-bun.ts",
        "import": "./src/worker-bun.ts"
      },
      "types": "./src/worker-browser.ts",
      "import": "./src/worker-node.ts"
    },
    "./bootstrap": {
      "types": "./src/bootstrap.ts",
      "import": "./src/bootstrap.ts"
    },
    "./auto-bootstrap": {
      "types": "./src/auto-bootstrap.ts",
      "import": "./src/auto-bootstrap.ts"
    }
  },
  "files": [
    "dist",
    "src/**/*.md"
  ],
  "sideEffects": [
    "./dist/auto-bootstrap.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@workglow/ai": "workspace:*",
    "@workglow/anthropic": "workspace:*",
    "@workglow/openai": "workspace:*",
    "@workglow/google-gemini": "workspace:*",
    "@workglow/ollama": "workspace:*",
    "@workglow/huggingface-transformers": "workspace:*",
    "@workglow/huggingface-inference": "workspace:*",
    "@workglow/tf-mediapipe": "workspace:*",
    "@workglow/chrome-ai": "workspace:*",
    "@workglow/knowledge-base": "workspace:*",
    "@workglow/job-queue": "workspace:*",
    "@workglow/postgres": "workspace:*",
    "@workglow/sqlite": "workspace:*",
    "@workglow/storage": "workspace:*",
    "@workglow/task-graph": "workspace:*",
    "@workglow/browser-control": "workspace:*",
    "@workglow/javascript": "workspace:*",
    "@workglow/mcp": "workspace:*",
    "@workglow/tasks": "workspace:*",
    "@workglow/util": "workspace:*",
    "tslog": "^4.9.3"
  }
}
